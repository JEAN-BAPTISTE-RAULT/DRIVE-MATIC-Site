{
  "name": "drive-matic/site",
  "description": "DRIVE-MATIC — site corporate de detail d'equipements automobiles (grand public + acces partenaire authentifie).",
  "type": "project",
  "license": "proprietary",
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "composer/installers": "^2.3",
    "cweagans/composer-patches": "^1.7",
    "drupal/admin_toolbar": "^3.6",
    "drupal/better_exposed_filters": "^7.1",
    "drupal/core-composer-scaffold": "^11.3",
    "drupal/core-project-message": "^11.3",
    "drupal/core-recommended": "^11.3",
    "drupal/crop": "^2.6",
    "drupal/easy_breadcrumb": "^2.0",
    "drupal/field_group": "^4.0",
    "drupal/gin": "^5.0",
    "drupal/honeypot": "^2.2",
    "drupal/image_widget_crop": "^3.0",
    "drupal/link_target": "^1.5",
    "drupal/linkit": "^7.0",
    "drupal/menu_link_attributes": "^1.7",
    "drupal/metatag": "^2.2",
    "drupal/paragraphs": "^1.23",
    "drupal/pathauto": "^1.15",
    "drupal/rabbit_hole": "^1.2",
    "drupal/recaptcha_v3": "^2.0",
    "drupal/redirect": "^1.13",
    "drupal/rename_admin_paths": "^3.1",
    "drupal/simple_sitemap": "^4.2",
    "drupal/symfony_mailer": "^2.0",
    "drupal/twig_tweak": "^3.4",
    "drupal/video_embed_field": "^3.1",
    "drupal/webform": "^6.3@beta",
    "drush/drush": "^13"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "drupal/cl_devel": "^2.0",
    "drupal/coder": "^8.3",
    "drupal/devel": "^5.5",
    "drupal/sdc_devel": "^1.0"
  },
  "conflict": {
    "drupal/drupal": "*"
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "cweagans/composer-patches": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "drupal/core-composer-scaffold": true,
      "drupal/core-project-message": true,
      "php-http/discovery": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "extra": {
    "composer-exit-on-patch-failure": true,
    "patches": {
      "drupal/easy_breadcrumb": {
        "Fil d'Ariane : preg_replace sans modificateur u casse un titre accentue (le « a » grave sort en U+FFFD)": "patches/easy_breadcrumb-2.0.9-normalizetext-modificateur-utf8.patch"
      }
    },
    "drupal-scaffold": {
      "locations": {
        "web-root": "web/"
      }
    },
    "installer-paths": {
      "web/core": [
        "type:drupal-core"
      ],
      "web/libraries/{$name}": [
        "type:drupal-library"
      ],
      "web/modules/contrib/{$name}": [
        "type:drupal-module"
      ],
      "web/profiles/contrib/{$name}": [
        "type:drupal-profile"
      ],
      "web/themes/contrib/{$name}": [
        "type:drupal-theme"
      ],
      "drush/Commands/contrib/{$name}": [
        "type:drupal-drush"
      ],
      "web/modules/custom/{$name}": [
        "type:drupal-custom-module"
      ],
      "web/themes/custom/{$name}": [
        "type:drupal-custom-theme"
      ],
      "recipes/{$name}": [
        "type:drupal-recipe"
      ]
    }
  }
}
