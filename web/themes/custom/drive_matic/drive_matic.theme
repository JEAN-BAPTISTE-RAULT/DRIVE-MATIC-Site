<?php

/**
 * @file
 * Fonctions de theme pour DRIVE-MATIC.
 */

declare(strict_types=1);

use Drupal\Component\Utility\Html;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Link;
use Drupal\Core\Menu\MenuLinkInterface;
use Drupal\Core\Menu\MenuTreeParameters;
use Drupal\Core\StringTranslation\ByteSizeMarkup;
use Drupal\file\FileInterface;
use Drupal\menu_link_content\MenuLinkContentInterface;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\ParagraphInterface;

/**
 * Bundles dont le titre de page est porte par un de leurs paragraphes.
 *
 * Sur ces types, la maquette place le titre dans un bloc : banniere
 * `image_full` pour un produit, `text_centered` pour la home et les pages
 * transform. Le bloc titre de page y est donc masque.
 *
 * Cette liste double la condition de visibilite du bloc
 * `block.block.drive_matic_page_title` (`entity_bundle:node`, negee) : les deux
 * doivent rester alignees, sans quoi une page se retrouve avec deux `<h1>`
 * ou aucun.
 *
 * @return string[]
 *   Les machine names des bundles concernes.
 */
function _drive_matic_hero_title_bundles(): array {
  return ['homepage', 'transform', 'product'];
}

/**
 * Implements hook_preprocess_HOOK() for paragraph.
 *
 * Les blocs home `news_home` / `brands_home` rendent une liste d'entites via
 * `drupal_view_result()` + `drupal_entity()` (cf. templates paragraph--*_home).
 * Ce rendu ne fait remonter que les cache tags des entites rendues, pas le
 * `node_list` de la Vue : on l'ajoute explicitement pour que le bloc soit
 * invalide a la publication/suppression d'une actualite ou d'une marque.
 *
 * `product_characteristics` expose en plus ses deux telechargements sous forme
 * de donnees pretes a afficher (cf. _drive_matic_document_downloads()).
 */
function drive_matic_preprocess_paragraph(array &$variables): void {
  $paragraph = $variables['paragraph'];

  $list_tag = [
    'news_home' => 'node_list:news',
    'brands_home' => 'node_list:brand',
  ][$paragraph->bundle()] ?? NULL;

  if ($list_tag !== NULL) {
    $variables['#cache']['tags'][] = $list_tag;
  }

  if ($paragraph->bundle() === 'product_characteristics') {
    $variables['downloads'] = _drive_matic_document_downloads(
      $paragraph,
      ['field_file_notice', 'field_file_doc'],
      $variables
    );
  }

  if ($paragraph->bundle() === 'product_cross_element') {
    $variables['card_link'] = _drive_matic_titled_link($paragraph);
  }

  $variables['heading_level'] = _drive_matic_heading_level($paragraph);
}

/**
 * Determine le niveau de titre : 1 pour le paragraphe qui titre la page.
 *
 * Sur les bundles de _drive_matic_hero_title_bundles(), le bloc titre est
 * masque : c'est un paragraphe qui porte le `<h1>`. Partout ailleurs le `<h1>`
 * vient du bloc titre et les paragraphes restent en `<h2>`.
 *
 * On retient le **premier paragraphe qui porte effectivement un titre**, et non
 * le premier paragraphe tout court : sur une page transform, la maquette place
 * le titre sous la banniere, donc le bloc d'ouverture est une `image_full` sans
 * titre et le `<h1>` revient au `text_centered` suivant. Seuls les bundles dont
 * le SDC accepte la prop sont candidats.
 *
 * Le test porte sur le parent : un paragraphe imbrique (element de grille, de
 * carrousel…) n'est jamais le titre de la page, meme premier de sa liste.
 *
 * @param \Drupal\paragraphs\ParagraphInterface $paragraph
 *   Le paragraphe rendu.
 *
 * @return int
 *   1 pour le paragraphe qui titre la page, 2 sinon.
 */
function _drive_matic_heading_level(ParagraphInterface $paragraph): int {
  // Bundles dont le SDC expose la prop `heading_level`.
  $candidates = ['image_full', 'text_centered'];
  $parent = $paragraph->getParentEntity();

  if (!$parent instanceof NodeInterface
    || !in_array($parent->bundle(), _drive_matic_hero_title_bundles(), TRUE)
    || !$parent->hasField('field_paragraphs')) {
    return 2;
  }

  foreach ($parent->get('field_paragraphs') as $item) {
    $candidate = $item->entity;

    if (!$candidate instanceof ParagraphInterface
      || !in_array($candidate->bundle(), $candidates, TRUE)
      || $candidate->get('field_title')->isEmpty()) {
      continue;
    }

    return (int) $candidate->id() === (int) $paragraph->id() ? 1 : 2;
  }

  return 2;
}

/**
 * Compose le lien d'une carte de cross-selling : titre + destination.
 *
 * La maquette n'affiche qu'une ligne cliquable par carte, alors que l'Element
 * porte un titre ET un lien, tous deux obligatoires : le **titre** fournit le
 * libelle, le **lien** la destination. On construit donc le lien ici plutot que
 * de rendre le champ (qui afficherait son propre libelle) — en partant de
 * l'objet Url du champ, pour conserver les options saisies en back-office,
 * dont la cible d'ouverture (ADR-002).
 *
 * @param \Drupal\paragraphs\ParagraphInterface $paragraph
 *   Le paragraphe `product_cross_element`.
 *
 * @return array
 *   Tableau rendu du lien, ou tableau vide si un des deux champs manque.
 */
function _drive_matic_titled_link(ParagraphInterface $paragraph): array {
  $item = $paragraph->get('field_link')->first();
  $title = $paragraph->get('field_title')->value;

  if ($item === NULL || $title === NULL || $title === '') {
    return [];
  }

  return Link::fromTextAndUrl($title, $item->getUrl())->toRenderable();
}

/**
 * Construit des boutons de telechargement nommes a partir de champs fichier.
 *
 * Le bouton global (`file-link.html.twig`) affiche « Télécharger (FORMAT
 * POIDS) », ce qui ne convient pas quand un bloc en porte plusieurs : ils
 * seraient indiscernables. Le libelle vient donc de la **description du
 * fichier**, saisie en back-office par la personne qui depose le document
 * (`description_field` active sur le champ) ; a defaut, on retombe sur le nom
 * du fichier. Format et poids restent calcules, comme pour le bouton global.
 *
 * @param \Drupal\paragraphs\ParagraphInterface $paragraph
 *   Le paragraphe portant les champs fichier.
 * @param array $field_names
 *   Noms des champs fichier, dans l'ordre d'affichage.
 * @param array $variables
 *   Variables du template, pour y attacher les cache tags des fichiers.
 *
 * @return array
 *   Liste de tableaux `label`, `url`, `format`, `size` (champs vides ignores).
 */
function _drive_matic_document_downloads(ParagraphInterface $paragraph, array $field_names, array &$variables): array {
  $downloads = [];

  foreach ($field_names as $field_name) {
    if (!$paragraph->hasField($field_name) || $paragraph->get($field_name)->isEmpty()) {
      continue;
    }
    $item = $paragraph->get($field_name)->first();
    $file = $item->entity;
    if (!$file instanceof FileInterface) {
      continue;
    }

    // Libelle editorial ; repli sur le nom du fichier prive de son extension.
    $label = trim((string) $item->description);
    if ($label === '') {
      $label = pathinfo($file->getFilename(), PATHINFO_FILENAME);
    }

    $downloads[] = [
      'label' => $label,
      'url' => \Drupal::service('file_url_generator')->generateString($file->getFileUri()),
      'format' => mb_strtoupper(pathinfo($file->getFilename(), PATHINFO_EXTENSION)),
      'size' => ByteSizeMarkup::create((int) $file->getSize()),
    ];

    // Le fichier n'est pas rendu par son formatter : ses cache tags ne
    // remontent pas tout seuls.
    $variables['#cache']['tags'] = array_merge(
      $variables['#cache']['tags'] ?? [],
      $file->getCacheTags()
    );
  }

  return $downloads;
}

/**
 * Construit les tuples de telechargement d'un champ fichier multi-valeur.
 *
 * Distinct de _drive_matic_document_downloads() : celle-ci boucle plusieurs
 * champs mono-valeur nommes (un bouton par champ), celle-ci boucle les deltas
 * d'un **seul** champ a cardinalite illimitee (un bouton par fichier saisi).
 * Meme construction du tuple (libelle/format/poids/cache tags) que l'autre
 * fonction, dupliquee plutot que fusionnee : les deux iterations n'ont pas la
 * meme forme et _drive_matic_document_downloads() sert deja un appelant qui
 * fonctionne (`product_characteristics`).
 *
 * @param \Drupal\Core\Field\FieldItemListInterface $field
 *   Le champ fichier (cardinalite illimitee, description_field actif).
 * @param array $variables
 *   Variables du template, pour y attacher les cache tags des fichiers.
 *
 * @return array
 *   Liste de tableaux `label`, `url`, `format`, `size` (deltas vides ignores).
 */
function _drive_matic_field_downloads(FieldItemListInterface $field, array &$variables): array {
  $downloads = [];

  foreach ($field as $item) {
    $file = $item->entity;
    if (!$file instanceof FileInterface) {
      continue;
    }

    // Libelle editorial ; repli sur le nom du fichier prive de son extension.
    $label = trim((string) $item->description);
    if ($label === '') {
      $label = pathinfo($file->getFilename(), PATHINFO_FILENAME);
    }

    $downloads[] = [
      'label' => $label,
      'url' => \Drupal::service('file_url_generator')->generateString($file->getFileUri()),
      'format' => mb_strtoupper(pathinfo($file->getFilename(), PATHINFO_EXTENSION)),
      'size' => ByteSizeMarkup::create((int) $file->getSize()),
    ];

    // Le fichier n'est pas rendu par son formatter : ses cache tags ne
    // remontent pas tout seuls.
    $variables['#cache']['tags'] = array_merge(
      $variables['#cache']['tags'] ?? [],
      $file->getCacheTags()
    );
  }

  return $downloads;
}

/**
 * Implements hook_preprocess_HOOK() for node.
 *
 * Bundle `documents` (F6) uniquement : les deux champs fichier a iteration
 * illimitee (`field_documents_school`, `field_documents_pmr`) ne passent pas
 * par leur formatter — la maquette rend chaque fichier en ligne cliquable
 * (nom + format + poids, « Telecharger » a droite), pas par le bouton pilule
 * partage `.file-download` (cf. drive_matic_preprocess_file_link()). Les
 * titres de section restent en dur, comme avant ce chantier, pour que le
 * gabarit ne depende pas de la configuration ; une section sans fichier est
 * simplement absente du tableau `sections`.
 */
function drive_matic_preprocess_node(array &$variables): void {
  $node = $variables['node'];

  if (!$node instanceof NodeInterface || $node->bundle() !== 'documents') {
    return;
  }

  $sections = [
    [
      'title' => t('Auto-écoles'),
      'files' => _drive_matic_field_downloads($node->get('field_documents_school'), $variables),
    ],
    [
      'title' => t('PMR'),
      'files' => _drive_matic_field_downloads($node->get('field_documents_pmr'), $variables),
    ],
  ];

  $variables['sections'] = array_filter($sections, static function (array $section): bool {
    return $section['files'] !== [];
  });
}

/**
 * Implements hook_preprocess_HOOK() for file_link.
 *
 * Le lien de telechargement de la maquette affiche un libelle suivi du format
 * et du poids, plutot que le nom brut du fichier. On expose l'URL, le format et
 * le libelle ; le poids (`file_size`) est deja fourni par le coeur mais n'etait
 * pas affiche.
 *
 * Le libelle est **editorial** : c'est la description du fichier saisie en
 * back-office (`description_field` active sur les champs fichier, cf. ADR-009).
 * A defaut, le bouton garde le « Télécharger » de la maquette — c'est le cas
 * des blocs a document unique, ou aucune ambiguite n'est possible. Les blocs
 * multi-documents ne passent pas par ici (cf.
 * _drive_matic_document_downloads()).
 */
function drive_matic_preprocess_file_link(array &$variables): void {
  $file = $variables['file'] ?? NULL;
  if (!$file instanceof FileInterface) {
    return;
  }
  $variables['download_url'] = \Drupal::service('file_url_generator')
    ->generateString($file->getFileUri());
  $extension = pathinfo($file->getFilename(), PATHINFO_EXTENSION);
  $variables['file_extension'] = mb_strtoupper($extension);

  $description = trim((string) ($variables['description'] ?? ''));
  $variables['download_label'] = $description !== '' ? $description : t('Télécharger');
}

/**
 * Visuels d'aide disponibles, par nom.
 *
 * Les maquettes 438-9456 et 438-9457 remplacent l'infobulle texte de Webform
 * par une modale montrant un certificat d'immatriculation, la case concernee
 * entouree.
 *
 * Un element de formulaire demande son visuel par nom, via
 * `#help_attributes: { data-dm-help-visual: <nom> }` : la configuration nomme
 * un besoin, le theme decide du fichier et de son alternative textuelle. Un
 * nom inconnu (ou absent) laisse l'infobulle par defaut de Webform.
 *
 * @return array[]
 *   Tableau indexe par nom de visuel : fichier dans `images/help/`, dimensions
 *   intrinseques, alternative textuelle.
 */
function _drive_matic_help_visuals(): array {
  return [
    'chassis-numero' => [
      'file' => 'carte-grise-case-e.webp',
      'width' => 1000,
      'height' => 1804,
      'alt' => 'Certificat d’immatriculation : la case E, numéro de châssis, est entourée en rouge.',
    ],
    'chassis-type' => [
      'file' => 'carte-grise-case-d21.webp',
      'width' => 1000,
      'height' => 1804,
      'alt' => 'Certificat d’immatriculation : la case D.2.1, type de châssis, est entourée en rouge.',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for webform_element_help.
 *
 * Prepare la modale d'aide illustree quand l'element en a un visuel. Le rendu
 * lui-meme est dans le SDC `help-modal`, embarque par le template surcharge
 * webform-element-help.html.twig.
 *
 * A noter : ce hook de theme ne declare que `help`, `help_title` et
 * `attributes` (WebformThemeHooks::theme()) — il n'y a pas de variable
 * `element`, donc aucun moyen de retrouver le champ d'origine. D'ou le nom du
 * visuel passe en attribut.
 *
 * Le repli sans JS reprend le texte de `#help`. Attention : quand c'est un
 * tableau de rendu, le preprocess de Webform l'a deja rendu pour alimenter
 * `data-webform-help` — il est donc marque `#printed` et le rendre a nouveau
 * donnerait une chaine vide. On lit `#markup`, ou le rendu a ete depose.
 */
function drive_matic_preprocess_webform_element_help(array &$variables): void {
  $name = (string) ($variables['attributes']['data-dm-help-visual'] ?? '');
  $visual = _drive_matic_help_visuals()[$name] ?? NULL;
  if ($visual === NULL) {
    return;
  }

  $help = $variables['help'];
  $fallback = is_string($help) ? $help : (string) ($help['#markup'] ?? '');

  $theme_path = \Drupal::service('extension.list.theme')->getPath('drive_matic');

  $variables['help_modal'] = [
    '#type' => 'component',
    '#component' => 'drive_matic:help-modal',
    '#props' => [
      'id' => Html::getUniqueId('help-' . $name),
      'title' => (string) $variables['help_title'],
      'fallback' => $fallback,
      'image' => base_path() . $theme_path . '/images/help/' . $visual['file'],
      'image_alt' => $visual['alt'],
      'image_width' => $visual['width'],
      'image_height' => $visual['height'],
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for bef_links.
 *
 * La maquette de la FAQ (396-11620) ne pose que les trois categories, sans
 * entree « tout » : on retire donc le lien que BEF ajoute en tete de liste. Le
 * retour a « toutes les categories » reste possible en recliquant l'onglet
 * actif — son lien pointe deja vers la page sans parametre.
 *
 * On agit sur les variables du template, PAS sur `#options` : la valeur du
 * filtre vaut `All` tant que rien n'est filtre, et retirer l'option ferait
 * echouer la validation « choix illegal » du Form API.
 */
function drive_matic_preprocess_bef_links(array &$variables): void {
  if (($variables['element']['#name'] ?? '') !== 'categorie') {
    return;
  }

  unset($variables['element']['All'], $variables['links']['All']);
  $variables['children'] = array_values(
    array_diff($variables['children'], ['All'])
  );
}

/**
 * Implements hook_preprocess_HOOK() for page.
 *
 * Le mega-menu du header (F2) distingue, au niveau 2, des enfants avec
 * visuel (rendus en carte) et sans visuel (rendus en simple lien) — une
 * distinction que le rendu standard d'un system_menu_block (liste imbriquee)
 * ne permet pas d'exprimer. On charge donc l'arbre du menu "main"
 * directement, pour le passer en prop structuree au SDC `site-header`. Le
 * menu "account" (region secondary_menu, dropdown « Espace partenaire »)
 * reste rendu par son bloc standard (page.secondary_menu) : liste plate, la
 * distinction carte/lien ne s'y applique pas.
 */
function drive_matic_preprocess_page(array &$variables): void {
  $variables['main_navigation'] = _drive_matic_main_navigation($variables);
  $variables['devis_url'] = _drive_matic_devis_cta_url();
}

/**
 * URL du bouton « Demander un devis » du header (F2).
 *
 * Le type de contenu `contact` est a exemplaire unique
 * (docs/content-model.md) : on pointe donc vers lui plutot que vers un href
 * en dur, pour survivre a un renommage de page. Recherche par bundle plutot
 * que par nid : pas de numero magique a resynchroniser si le node est
 * recree.
 *
 * @return string
 *   L'URL de la page de contact, ou '#' si la page n'existe pas encore.
 */
function _drive_matic_devis_cta_url(): string {
  $nodes = \Drupal::entityTypeManager()->getStorage('node')
    ->loadByProperties(['type' => 'contact']);
  $node = reset($nodes);
  return $node ? $node->toUrl()->toString() : '#';
}

/**
 * Implements hook_preprocess_HOOK() for page--user--login.html.twig.
 *
 * Calcule les 3 URLs des cartes d'action du SDC `login-panel` (page de
 * connexion, F2). "Créer un compte"/"faire une demande" et "Devenir
 * partenaire" pointent vers les 2 nodes du bundle mutualise `simple_form` :
 * la recherche par bundle seul ne suffit plus (contrairement a
 * `_drive_matic_devis_cta_url()`), le bundle etant multi-instance depuis sa
 * mutualisation (ADR-024) — on distingue donc aussi par titre.
 *
 * Suggestion `page__user__login` : construite par
 * `SystemThemeHooks::themeSuggestionsPage()` a partir des segments du chemin
 * interne (`user` + `login`), pas du nom de la route.
 */
function drive_matic_preprocess_page__user__login(array &$variables): void {
  $variables['request_account_url'] = _drive_matic_simple_form_node_url('Demande de création de compte');
  $variables['partner_url'] = _drive_matic_simple_form_node_url('Devenir partenaire');
  $variables['quote_url'] = _drive_matic_devis_cta_url();
}

/**
 * URL d'un node du bundle mutualise `simple_form`, identifie par son titre.
 *
 * @param string $title
 *   Le titre exact du node cible.
 *
 * @return string
 *   L'URL du node, ou '#' si introuvable.
 */
function _drive_matic_simple_form_node_url(string $title): string {
  $nodes = \Drupal::entityTypeManager()->getStorage('node')
    ->loadByProperties(['type' => 'simple_form', 'title' => $title]);
  $node = reset($nodes);
  return $node ? $node->toUrl()->toString() : '#';
}

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 *
 * Aligne le titre d'onglet sur le bouton et le fil d'Ariane : "Me connecter"
 * plutot que "Se connecter" (libelle par defaut du cœur pour la route
 * `user.login`). Meme demarche que le reglage `replaced_titles`
 * d'easy_breadcrumb pour le fil d'Ariane, mais applique ici a la variable de
 * gabarit `head_title` plutot qu'a la route elle-meme — qui reste "Se
 * connecter" partout ou elle est utilisee ailleurs (ex. onglets locaux,
 * masques sur cette page mais toujours en base).
 *
 * Les hooks de theme s'executent apres ceux des modules : `head_title`
 * porte deja ici la chaine composee par metatag (« Se connecter | Drive
 * Matic Legrand »), pas seulement le titre de la page — l'ecraser
 * completement aurait aussi perdu le nom du site. On y remplace donc
 * seulement le libelle, pas toute la valeur.
 *
 * Expose aussi `favicon_path` (jeu d'icones favicon.io, `images/favicon/`) :
 * `toggle.favicon` du theme est desactive (`system.theme.global`), ce jeu
 * remplacant entierement le mecanisme a une seule icone du cœur.
 */
function drive_matic_preprocess_html(array &$variables): void {
  if (\Drupal::routeMatch()->getRouteName() === 'user.login' && !empty($variables['head_title']['title'])) {
    $variables['head_title']['title'] = str_replace(
      'Se connecter',
      (string) t('Me connecter'),
      (string) $variables['head_title']['title']
    );
  }

  $theme_path = \Drupal::service('extension.list.theme')->getPath('drive_matic');
  $variables['favicon_path'] = base_path() . $theme_path . '/images/favicon';
}

/**
 * Construit l'arbre du menu "main" pour le SDC `site-header`.
 *
 * @param array $page_variables
 *   Variables du template page, pour y attacher les cache tags du menu et
 *   des entites chargees (menu et fichiers ne remontent pas leurs tags tout
 *   seuls hors du rendu d'un bloc).
 *
 * @return array[]
 *   Un tableau par rubrique de niveau 1 : title, id (pour aria-controls),
 *   cards (enfants avec `field_nav_card_image`) et link_groups (les autres,
 *   groupes par colonne).
 */
function _drive_matic_main_navigation(array &$page_variables): array {
  $params = new MenuTreeParameters();
  $params->setMaxDepth(3)->onlyEnabledLinks();
  $tree = \Drupal::menuTree()->load('main', $params);
  $tree = \Drupal::menuTree()->transform($tree, [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);

  $page_variables['#cache']['tags'][] = 'config:system.menu.main';

  $navigation = [];
  foreach ($tree as $element) {
    if (!$element->access) {
      continue;
    }
    $link = $element->link;
    $item = [
      'title' => $link->getTitle(),
      'id' => Html::getId(\Drupal::transliteration()->transliterate($link->getTitle())),
      'cards' => [],
      'link_groups' => [],
    ];

    // Les liens "a plat" (rubriques sans sous-groupe) s'accumulent ici avant
    // d'etre pousses comme une seule colonne ; un enfant qui porte lui-meme
    // des enfants (ex. "Colonne 1/2/3" sous Drive Matic, maquette node
    // 433:9459) n'est jamais affiche : seuls ses enfants forment une colonne
    // dediee, separee des autres par un filet.
    $flat_links = [];
    foreach ($element->subtree as $child_element) {
      if (!$child_element->access) {
        continue;
      }
      $child_link = $child_element->link;

      if ($child_element->subtree) {
        if ($flat_links) {
          $item['link_groups'][] = $flat_links;
          $flat_links = [];
        }
        $group = [];
        foreach ($child_element->subtree as $grandchild_element) {
          if (!$grandchild_element->access) {
            continue;
          }
          $grandchild_link = $grandchild_element->link;
          $group[] = [
            'title' => $grandchild_link->getTitle(),
            'url' => $grandchild_link->getUrlObject()->toString(),
          ];
        }
        if ($group) {
          $item['link_groups'][] = $group;
        }
        continue;
      }

      $child = [
        'title' => $child_link->getTitle(),
        'url' => $child_link->getUrlObject()->toString(),
      ];
      $image = _drive_matic_nav_card_image($child_link, $page_variables);
      if ($image !== NULL) {
        $child['image'] = $image;
        $item['cards'][] = $child;
      }
      else {
        $flat_links[] = $child;
      }
    }
    if ($flat_links) {
      $item['link_groups'][] = $flat_links;
    }

    $navigation[] = $item;
  }

  return $navigation;
}

/**
 * Rend le visuel de carte d'un lien de menu, s'il en porte un.
 *
 * La presence d'une image sur `field_nav_card_image` decide, a elle seule,
 * si un enfant de niveau 2 est rendu en carte ou en simple lien (cf.
 * decision du 2026-08-20, header F2) : pas de champ booleen separe a
 * maintenir en coherence.
 *
 * @param \Drupal\Core\Menu\MenuLinkInterface $link
 *   Le lien de niveau 2 (plugin de menu).
 * @param array $page_variables
 *   Variables du template page, pour y attacher les cache tags de l'entite.
 *
 * @return array|null
 *   Le champ image rendu (formatter `responsive_image`, style `dm_16_9`), ou
 *   NULL si le lien n'est pas un `menu_link_content` ou n'a pas de visuel.
 */
function _drive_matic_nav_card_image(MenuLinkInterface $link, array &$page_variables): ?array {
  $plugin_id = $link->getPluginId();
  if (!str_starts_with($plugin_id, 'menu_link_content:')) {
    return NULL;
  }

  $uuid = substr($plugin_id, strlen('menu_link_content:'));
  $entity = \Drupal::service('entity.repository')->loadEntityByUuid('menu_link_content', $uuid);
  if (!$entity instanceof MenuLinkContentInterface
    || !$entity->hasField('field_nav_card_image')
    || $entity->get('field_nav_card_image')->isEmpty()) {
    return NULL;
  }

  $page_variables['#cache']['tags'] = array_merge(
    $page_variables['#cache']['tags'] ?? [],
    $entity->getCacheTags()
  );

  return $entity->get('field_nav_card_image')->view([
    'type' => 'responsive_image',
    'label' => 'hidden',
    'settings' => [
      'responsive_image_style' => 'dm_16_9',
      'image_loading' => ['attribute' => 'lazy'],
    ],
  ]);
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for views_exposed_form.
 *
 * La maquette de la FAQ n'affiche pas de libelle au-dessus des onglets. On le
 * masque visuellement plutot que de le supprimer : il reste le seul intitule
 * du groupe de liens pour un lecteur d'ecran.
 */
function drive_matic_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (($form['#id'] ?? '') !== 'views-exposed-form-faq-block-1') {
    return;
  }

  $form['categorie']['#title_display'] = 'invisible';
}
