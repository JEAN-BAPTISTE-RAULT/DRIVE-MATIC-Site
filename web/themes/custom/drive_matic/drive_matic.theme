<?php

/**
 * @file
 * Fonctions de theme pour DRIVE-MATIC.
 */

declare(strict_types=1);

use Drupal\Core\StringTranslation\ByteSizeMarkup;
use Drupal\file\FileInterface;
use Drupal\paragraphs\ParagraphInterface;

/**
 * Implements hook_preprocess_HOOK() for paragraph.
 *
 * Les blocs home `news_home` / `brands_home` rendent une liste d'entites via
 * `drupal_view_result()` + `drupal_entity()` (cf. templates paragraph--*_home).
 * Ce rendu ne fait remonter que les cache tags des entites rendues, pas le
 * `node_list` de la Vue : on l'ajoute explicitement pour que le bloc soit
 * invalide a la publication/suppression d'une actualite ou d'une marque.
 *
 * `product_characteristics` expose en plus ses deux telechargements sous forme
 * de donnees pretes a afficher (cf. _drive_matic_document_downloads()).
 */
function drive_matic_preprocess_paragraph(array &$variables): void {
  $paragraph = $variables['paragraph'];

  $list_tag = [
    'news_home' => 'node_list:news',
    'brands_home' => 'node_list:brand',
  ][$paragraph->bundle()] ?? NULL;

  if ($list_tag !== NULL) {
    $variables['#cache']['tags'][] = $list_tag;
  }

  if ($paragraph->bundle() === 'product_characteristics') {
    $variables['downloads'] = _drive_matic_document_downloads(
      $paragraph,
      ['field_file_notice', 'field_file_doc'],
      $variables
    );
  }
}

/**
 * Construit des boutons de telechargement nommes a partir de champs fichier.
 *
 * Le bouton global (`file-link.html.twig`) affiche « Télécharger (FORMAT
 * POIDS) », ce qui ne convient pas quand un bloc en porte plusieurs : ils
 * seraient indiscernables. Le libelle vient donc de la **description du
 * fichier**, saisie en back-office par la personne qui depose le document
 * (`description_field` active sur le champ) ; a defaut, on retombe sur le nom
 * du fichier. Format et poids restent calcules, comme pour le bouton global.
 *
 * @param \Drupal\paragraphs\ParagraphInterface $paragraph
 *   Le paragraphe portant les champs fichier.
 * @param array $field_names
 *   Noms des champs fichier, dans l'ordre d'affichage.
 * @param array $variables
 *   Variables du template, pour y attacher les cache tags des fichiers.
 *
 * @return array
 *   Liste de tableaux `label`, `url`, `format`, `size` (champs vides ignores).
 */
function _drive_matic_document_downloads(ParagraphInterface $paragraph, array $field_names, array &$variables): array {
  $downloads = [];

  foreach ($field_names as $field_name) {
    if (!$paragraph->hasField($field_name) || $paragraph->get($field_name)->isEmpty()) {
      continue;
    }
    $item = $paragraph->get($field_name)->first();
    $file = $item->entity;
    if (!$file instanceof FileInterface) {
      continue;
    }

    // Libelle editorial ; repli sur le nom du fichier prive de son extension.
    $label = trim((string) $item->description);
    if ($label === '') {
      $label = pathinfo($file->getFilename(), PATHINFO_FILENAME);
    }

    $downloads[] = [
      'label' => $label,
      'url' => \Drupal::service('file_url_generator')->generateString($file->getFileUri()),
      'format' => mb_strtoupper(pathinfo($file->getFilename(), PATHINFO_EXTENSION)),
      'size' => ByteSizeMarkup::create((int) $file->getSize()),
    ];

    // Le fichier n'est pas rendu par son formatter : ses cache tags ne
    // remontent pas tout seuls.
    $variables['#cache']['tags'] = array_merge(
      $variables['#cache']['tags'] ?? [],
      $file->getCacheTags()
    );
  }

  return $downloads;
}

/**
 * Implements hook_preprocess_HOOK() for file_link.
 *
 * Le lien de telechargement de la maquette affiche un libelle suivi du format
 * et du poids, plutot que le nom brut du fichier. On expose l'URL, le format et
 * le libelle ; le poids (`file_size`) est deja fourni par le coeur mais n'etait
 * pas affiche.
 *
 * Le libelle est **editorial** : c'est la description du fichier saisie en
 * back-office (`description_field` active sur les champs fichier, cf. ADR-009).
 * A defaut, le bouton garde le « Télécharger » de la maquette — c'est le cas
 * des blocs a document unique, ou aucune ambiguite n'est possible. Les blocs
 * multi-documents ne passent pas par ici (cf.
 * _drive_matic_document_downloads()).
 */
function drive_matic_preprocess_file_link(array &$variables): void {
  $file = $variables['file'] ?? NULL;
  if (!$file instanceof FileInterface) {
    return;
  }
  $variables['download_url'] = \Drupal::service('file_url_generator')
    ->generateString($file->getFileUri());
  $extension = pathinfo($file->getFilename(), PATHINFO_EXTENSION);
  $variables['file_extension'] = mb_strtoupper($extension);

  $description = trim((string) ($variables['description'] ?? ''));
  $variables['download_label'] = $description !== '' ? $description : t('Télécharger');
}
