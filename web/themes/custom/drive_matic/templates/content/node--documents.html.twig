{#
/**
 * @file
 * Page « Documentations » (F6), maquette 398-12119.
 *
 * Affiche le chapô (`body`) dans le SDC `page-intro`, puis le SDC
 * `documents-list` pour les deux sections de fichiers. Les fichiers ne
 * passent plus par leur formatter de champ : `sections` est construit en
 * preprocess (`drive_matic_preprocess_node()`) à partir des champs bruts, une
 * ligne par fichier restant à télécharger en entier (nom + format + poids,
 * calculés).
 *
 * Le titre de la page n'est pas rendu ici : il vient du bloc titre de page, qui
 * est visible sur ce bundle (ADR-014). Le rendre ici le doublerait.
 *
 * Une section sans fichier n'est pas dans `sections` : pas de titre orphelin (F6).
 *
 * @see node.html.twig pour la liste complète des variables.
 * @see drive_matic_preprocess_node()
 */
#}
<article{{ attributes.addClass('node', 'node--type-documents') }}>
  {% if content.body|render|trim is not empty %}
    {% embed 'drive_matic:page-intro' %}
      {% block text %}{{ content.body }}{% endblock %}
    {% endembed %}
  {% endif %}

  {{ include('drive_matic:documents-list', { sections: sections }) }}
</article>
