{#
  Page « Toutes les actualités » (F8) — corps de texte éditorial, puis la liste
  paginée produite par la Vue `all_news` (10 par page, tri sur la dernière
  modification). Pas de titre de node : il est rendu par le bloc titre de page
  depuis `field_title` (ADR-011).
  @see node.html.twig pour la liste complète des variables.
#}
<article{{ attributes.addClass('node', 'node--type-all-news') }}>
  {{ content }}
  {{ drupal_view('all_news', 'block_1') }}
</article>
