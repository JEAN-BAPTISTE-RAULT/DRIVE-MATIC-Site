{#
  Page « Marques partenaires » (F7) — texte d'introduction, puis la Vue
  `brands` : toutes les marques publiées, en ordre alphabétique. Les logos ne
  sont pas cliquables (la page canonique du fragment `brand` est bloquée).
  Pas de titre de node : il est rendu par le bloc titre de page depuis
  `field_title` (ADR-011).
  @see node.html.twig pour la liste complète des variables.
#}
<article{{ attributes.addClass('node', 'node--type-brands') }}>
  {{ content }}
  {{ drupal_view('brands', 'block_1') }}
</article>
