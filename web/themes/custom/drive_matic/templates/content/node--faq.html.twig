{#
  Page FAQ (F9) — texte d'introduction, puis la Vue `faq` : filtre exposé par
  catégorie et questions rendues en accordéon (fermeture du précédent à
  l'ouverture, comportement du SDC `accordion`). Pas de titre de node : il est
  rendu par le bloc titre de page depuis le `title` du node.
  @see node.html.twig pour la liste complète des variables.
#}
<article{{ attributes.addClass('node', 'node--type-faq') }}>
  {{ content }}
  {{ drupal_view('faq', 'block_1') }}
</article>
