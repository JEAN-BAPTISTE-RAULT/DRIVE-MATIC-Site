{#
/**
 * @file
 * Theme override for a link to a file.
 *
 * Rendu maquette : bouton « LIBELLÉ (FORMAT POIDS) » avec icône globe. Le
 * libellé est la description du fichier saisie en back-office, ou « Télécharger »
 * à défaut (cf. ADR-009).
 *
 * Variables (coeur) :
 * - link : lien vers le fichier (repli).
 * - file_size : poids formaté du fichier.
 * - description : description du fichier saisie en back-office.
 * Variables ajoutées par drive_matic_preprocess_file_link() :
 * - download_url : URL directe du fichier.
 * - file_extension : extension en majuscules (ex. PDF).
 * - download_label : description saisie, ou « Télécharger ».
 *
 * @see drive_matic_preprocess_file_link()
 * @see \Drupal\file\Hook\FileThemeHooks::preprocessFileLink()
 */
#}
{{ attach_library('drive_matic/file') }}
{% if download_url %}
  <a href="{{ download_url }}" class="file-download" download>
    <span class="file-download__icon" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.5"/>
        <path d="M2.75 12h18.5M12 2.75c2.5 2.4 3.9 5.8 3.9 9.25 0 3.45-1.4 6.85-3.9 9.25-2.5-2.4-3.9-5.8-3.9-9.25 0-3.45 1.4-6.85 3.9-9.25Z" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </span>
    <span class="file-download__label">
      {{ download_label }}{% if file_extension or file_size %} ({{ file_extension }}{% if file_extension and file_size %} {% endif %}{{ file_size }}){% endif %}
    </span>
  </a>
{% else %}
  <span{{ attributes }}>{{ icon }} {{ link }}</span>
{% endif %}
