{#
  SDC « Site :: Pied de page » — bandeau sobre minimal.
  Shell minimal : le footer riche (coordonnées, solutions, assistance,
  réseaux sociaux, liens légaux) relève de F2 et viendra garnir le slot menu.
  Prop : site_name (obl). Slot : menu (liens de pied de page).
#}
<footer class="site-footer" role="contentinfo">
  <div class="site-footer__inner">
    <p class="site-footer__brand">{{ site_name }}</p>
    <div class="site-footer__menu">{{ block('menu') }}</div>
  </div>
  <p class="site-footer__copyright">
    © {{ 'now'|date('Y') }} {{ site_name }}. {{ 'Tous droits réservés.'|t }}
  </p>
</footer>
