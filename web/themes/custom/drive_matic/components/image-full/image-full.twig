{#
  SDC « Bloc :: Image 100% ».
  Prop : title. Slots (via embed/block) : image (bannière 12:5), actions (CTA).
  Titre et CTA superposés sur un voile sombre (contraste AA).
#}
<div class="image-full">
  <div class="image-full__media">{{ block('image') }}</div>
  {% if title or block('actions') is not empty %}
    <div class="image-full__overlay">
      {% if title %}
        {% set tag = 'h' ~ (heading_level|default(2)) %}
        <{{ tag }} class="image-full__title">{{ title }}</{{ tag }}>
      {% endif %}
      {% if block('actions') is not empty %}
        <div class="image-full__actions">{{ block('actions') }}</div>
      {% endif %}
    </div>
  {% endif %}
</div>
