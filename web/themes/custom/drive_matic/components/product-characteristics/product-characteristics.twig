{#
  SDC « Bloc :: Caractéristiques produit ».
  Props : title (opt), caption (opt). Slots : image (sans crop), characteristics
  (liste d'éléments), notice + documentation (fichiers à télécharger optionnels).
#}
<section class="product-characteristics">
  <div class="product-characteristics__media">
    {{ block('image') }}
    {% if caption %}<p class="product-characteristics__caption">{{ caption }}</p>{% endif %}
  </div>
  <div class="product-characteristics__body">
    {% if title %}<h2 class="product-characteristics__title">{{ title }}</h2>{% endif %}
    <div class="product-characteristics__list">{{ block('characteristics') }}</div>
    {% if block('notice') is not empty or block('documentation') is not empty %}
      <div class="product-characteristics__downloads">
        {{ block('notice') }}
        {{ block('documentation') }}
      </div>
    {% endif %}
  </div>
</section>
