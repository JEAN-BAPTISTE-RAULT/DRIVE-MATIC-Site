{#
  SDC « Élément :: Cross-selling produit » — carte produit liée.
  Slots : image (16:9), link (une seule ligne cliquable, cf. maquette : le titre
  de l'Élément en est le libellé et son champ lien la destination — le lien est
  composé en preprocess, `_drive_matic_titled_link()`).
#}
<article class="product-cross-element">
  <div class="product-cross-element__media">{{ block('image') }}</div>
  <h3 class="product-cross-element__title">{{ block('link') }}</h3>
</article>
