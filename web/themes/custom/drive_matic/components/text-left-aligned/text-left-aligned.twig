{#
  SDC « Bloc :: Texte aligné à gauche ».
  Prop : title. Slots (via embed/block) : description, actions, download.
  Fondations globales (tokens/typo) + CSS scopé BEM.
#}
<div class="text-left-aligned">
  {% if title %}
    <h2 class="text-left-aligned__title">{{ title }}</h2>
  {% endif %}
  {% if block('description') is not empty %}
    <div class="text-left-aligned__description">{{ block('description') }}</div>
  {% endif %}
  {% if block('actions') is not empty or block('download') is not empty %}
    <div class="text-left-aligned__cta-row">
      {% if block('actions') is not empty %}
        <div class="text-left-aligned__actions">{{ block('actions') }}</div>
      {% endif %}
      {% if block('download') is not empty %}
        <div class="text-left-aligned__download">{{ block('download') }}</div>
      {% endif %}
    </div>
  {% endif %}
</div>
