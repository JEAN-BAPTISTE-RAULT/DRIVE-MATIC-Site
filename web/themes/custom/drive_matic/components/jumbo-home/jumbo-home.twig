{#
  SDC « Bloc :: Jumbo Homepage » — bannière d'accueil en slideshow (Swiper).
  Slot : slides (diapositives `.swiper-slide`, 1 à 3 éléments jumbo).
  Slideshow si > 1 diapositive (init par `drive_matic/slideshow`), sinon
  bannière statique. Amélioration progressive : sans JS, la piste s'empile et
  reste lisible ; les flèches n'apparaissent que sous `html.js`.
  `data-dm-slideshow-edge-gutter-min-width="992"` : la piste ne déborde des
  deux côtés qu'à partir de ce palier (`jumbo-home.scss`,
  `&__viewport.swiper`) — sous ce palier, une seule diapositive plein cadre
  sans débordement, les gouttières de bord n'ont pas lieu d'être ajoutées.
#}
<section class="jumbo-home">
  <div
    class="jumbo-home__viewport swiper"
    data-dm-slideshow
    data-dm-slideshow-per-view="auto"
    data-dm-slideshow-space="20"
    data-dm-slideshow-edge-gutter
    data-dm-slideshow-edge-gutter-min-width="992"
  >
    <div class="swiper-wrapper">
      {{ block('slides') }}
    </div>
    <button
      type="button"
      class="jumbo-home__nav jumbo-home__nav--prev"
      data-dm-slideshow-prev
      aria-label="{{ 'Diapositive précédente'|t }}"
    ></button>
    <button
      type="button"
      class="jumbo-home__nav jumbo-home__nav--next"
      data-dm-slideshow-next
      aria-label="{{ 'Diapositive suivante'|t }}"
    ></button>
  </div>
  <div
    class="jumbo-home__pagination swiper-pagination"
    data-dm-slideshow-pagination
  ></div>
</section>
