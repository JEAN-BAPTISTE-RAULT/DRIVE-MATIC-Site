{#
  SDC « Bloc :: Marques Homepage ».
  Prop : title (obl). Slots : link (« marques partenaires », rendu en bouton sous
  la rangée), slides (logos de marques, chacun enveloppé en `.swiper-slide`).
  Swiper exige `.swiper-wrapper` en enfant DIRECT : c'est le SDC qui la fournit.
  Slideshow si > 1 diapositive. Les flèches encadrent la rangée (maquette), hors
  de la piste : le behavior les résout dans le conteneur du composant.
#}
<section class="brands-home">
  <h2 class="brands-home__title">{{ title }}</h2>
  <div class="brands-home__row">
    <button
      type="button"
      class="brands-home__nav-button brands-home__nav-button--prev"
      data-dm-slideshow-prev
      aria-label="{{ 'Marque précédente'|t }}"
    ></button>
    <div
      class="brands-home__viewport swiper"
      data-dm-slideshow
      data-dm-slideshow-per-view="auto"
      data-dm-slideshow-space="16"
    >
      <div class="swiper-wrapper">
        {{ block('slides') }}
      </div>
    </div>
    <button
      type="button"
      class="brands-home__nav-button brands-home__nav-button--next"
      data-dm-slideshow-next
      aria-label="{{ 'Marque suivante'|t }}"
    ></button>
  </div>
  {% if block('link') is not empty %}
    <div class="brands-home__more">{{ block('link') }}</div>
  {% endif %}
</section>
