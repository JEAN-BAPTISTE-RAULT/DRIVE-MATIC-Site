{#
  SDC « Élément :: Image produit » — une diapositive image de la présentation.
  Props : title (opt), caption (opt). Slots : image (16:9), description, actions
  (lien), download (fichier). Le corps ne s'affiche que s'il a du contenu.
#}
<figure class="product-image-element">
  <div class="product-image-element__media">{{ block('image') }}</div>
  {% if title or caption or block('description') is not empty or block('actions') is not empty or block('download') is not empty %}
    <figcaption class="product-image-element__body">
      {% if title %}<h3 class="product-image-element__title">{{ title }}</h3>{% endif %}
      {% if block('description') is not empty %}
        <div class="product-image-element__description">{{ block('description') }}</div>
      {% endif %}
      {% if caption %}<p class="product-image-element__caption">{{ caption }}</p>{% endif %}
      {% if block('actions') is not empty %}
        <div class="product-image-element__actions">{{ block('actions') }}</div>
      {% endif %}
      {% if block('download') is not empty %}
        <div class="product-image-element__download">{{ block('download') }}</div>
      {% endif %}
    </figcaption>
  {% endif %}
</figure>
