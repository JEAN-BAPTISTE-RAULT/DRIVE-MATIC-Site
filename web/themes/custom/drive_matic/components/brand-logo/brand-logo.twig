{#
  SDC « Carte :: Marque » — logo (sans crop) + nom. Aucun lien : la page
  canonique du fragment `brand` est bloquée (Rabbit Hole).
  Prop : name (obl). Slot : image (logo).
#}
<div class="brand-logo">
  <div class="brand-logo__image">{{ block('image') }}</div>
  <span class="brand-logo__name">{{ name }}</span>
</div>
