<?php

/**
 * @file
 * Fonctions de mise a jour du module DRIVE-MATIC Configurateur.
 */

declare(strict_types=1);

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\drivematic_configurator\Entity\Quote;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Renomme le statut de devis 'en_cours' en 'a_commander'.
 *
 * Le statut « En cours » devient « À commander » (cf. Entity/Quote.php,
 * `STATUS_A_COMMANDER`) : un 4e statut, « Commandé », est introduit a cote,
 * distinct de « À commander ». Renomme la valeur technique en base plutot
 * que de garder 'en_cours' avec un libelle change, pour eviter toute
 * confusion future entre le nom du champ et son sens reel.
 *
 * Idempotent : si aucune ligne ne porte encore 'en_cours', ne fait rien.
 */
function drivematic_configurator_update_11001(): string {
  $updated = \Drupal::database()->update('quote')
    ->fields(['status' => 'a_commander'])
    ->condition('status', 'en_cours')
    ->execute();

  return $updated
    ? sprintf('%d devis migre(s) de "en_cours" vers "a_commander".', $updated)
    : 'Aucun devis au statut "en_cours" : mise a jour ignoree (deja appliquee ou base vide).';
}

/**
 * Installe le champ `date_confirmation` sur l'entite `quote`.
 *
 * Date a laquelle Drive Matic confirme manuellement, en back-office, une
 * commande conclue par telephone avec le partenaire (statut
 * Quote::STATUS_COMMANDE) — distincte de `date_commande`, deja existante,
 * qui reste la date a laquelle le partenaire a clique « Commander » sur le
 * site (statut Quote::STATUS_A_COMMANDER).
 *
 * Idempotent : `installFieldStorageDefinition()` ne fait rien si le champ
 * existe deja.
 */
function drivematic_configurator_update_11002(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();

  if ($update_manager->getFieldStorageDefinition('date_confirmation', 'quote')) {
    return 'Champ "date_confirmation" deja installe sur "quote" : mise a jour ignoree.';
  }

  $storage_definition = BaseFieldDefinition::create('timestamp')
    ->setLabel(new TranslatableMarkup('Date de confirmation (téléphone)'))
    ->setName('date_confirmation')
    ->setTargetEntityTypeId('quote');

  $update_manager->installFieldStorageDefinition('date_confirmation', 'quote', 'drivematic_configurator', $storage_definition);

  return 'Champ "date_confirmation" installe sur l\'entite "quote".';
}

/**
 * Installe le champ `dm_discount_rate` sur l'entite `quote_equipment_line`.
 *
 * Remise exceptionnelle par ligne accordee par Drive Matic (PRD F15/F16,
 * « cas limites »), en plus de la remise globale du partenaire deja
 * appliquee dans `discounted_unit_price`/`discounted_ht`.
 *
 * Idempotent : `installFieldStorageDefinition()` ne fait rien si le champ
 * existe deja.
 */
function drivematic_configurator_update_11003(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();

  if ($update_manager->getFieldStorageDefinition('dm_discount_rate', 'quote_equipment_line')) {
    return 'Champ "dm_discount_rate" deja installe sur "quote_equipment_line" : mise a jour ignoree.';
  }

  $storage_definition = BaseFieldDefinition::create('decimal')
    ->setLabel(new TranslatableMarkup('Remise Drive Matic (%)'))
    ->setSetting('precision', 5)
    ->setSetting('scale', 2)
    ->setDefaultValue(0)
    ->setName('dm_discount_rate')
    ->setTargetEntityTypeId('quote_equipment_line');

  $update_manager->installFieldStorageDefinition('dm_discount_rate', 'quote_equipment_line', 'drivematic_configurator', $storage_definition);

  return 'Champ "dm_discount_rate" installe sur l\'entite "quote_equipment_line".';
}

/**
 * Installe la nouvelle entite `quote_status_change` (historique des devis).
 *
 * Une entree par transition de statut (creation, marquage manuel, ou
 * archivage automatique), voir Entity/QuoteStatusChange.php.
 *
 * Idempotent : ne fait rien si l'entite est deja installee.
 */
function drivematic_configurator_update_11004(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();

  if ($update_manager->getEntityType('quote_status_change')) {
    return 'Entite "quote_status_change" deja installee : mise a jour ignoree.';
  }

  \Drupal::entityTypeManager()->clearCachedDefinitions();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('quote_status_change');
  $update_manager->installEntityType($entity_type);

  return 'Entite "quote_status_change" installee.';
}

/**
 * Installe la nouvelle entite `quote_discount_change` (historique des remises).
 *
 * Une entree par ligne d'equipement dont la remise Drive Matic a change,
 * voir Entity/QuoteDiscountChange.php.
 *
 * Idempotent : ne fait rien si l'entite est deja installee.
 */
function drivematic_configurator_update_11005(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();

  if ($update_manager->getEntityType('quote_discount_change')) {
    return 'Entite "quote_discount_change" deja installee : mise a jour ignoree.';
  }

  \Drupal::entityTypeManager()->clearCachedDefinitions();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('quote_discount_change');
  $update_manager->installEntityType($entity_type);

  return 'Entite "quote_discount_change" installee.';
}

/**
 * Installe le champ `reference` sur l'entite `quote_equipment_line`.
 *
 * Copie gelee de `equipment_price.reference` (F17), au meme titre que
 * `unit_price` — necessaire au PDF du devis (maquette 714:9296, colonne
 * "Reference"). Les lignes deja persistees avant ce champ restent vides
 * (meme limite que `quote_discount_change`, ADR-040) : pas de backfill
 * retroactif possible, le catalogue ayant pu changer depuis.
 *
 * Idempotent : `installFieldStorageDefinition()` ne fait rien si le champ
 * existe deja.
 */
function drivematic_configurator_update_11006(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();

  if ($update_manager->getFieldStorageDefinition('reference', 'quote_equipment_line')) {
    return 'Champ "reference" deja installe sur "quote_equipment_line" : mise a jour ignoree.';
  }

  $storage_definition = BaseFieldDefinition::create('string')
    ->setLabel(new TranslatableMarkup('Référence catalogue'))
    ->setSetting('max_length', 64)
    ->setName('reference')
    ->setTargetEntityTypeId('quote_equipment_line');

  $update_manager->installFieldStorageDefinition('reference', 'quote_equipment_line', 'drivematic_configurator', $storage_definition);

  return 'Champ "reference" installe sur l\'entite "quote_equipment_line".';
}

/**
 * Supprime l'ancien champ de remise partenaire globale `field_discount_rate`.
 *
 * Remplace par 4 remises independantes par equipement
 * (field_discount_retrovision_ext/retrovision_int/telecommande_vor/pedalier,
 * voir config/sync), decision utilisatrice : aucune migration de valeur, les
 * 2 partenaires existants seront ressaisis a la main sur les 4 nouveaux
 * champs.
 *
 * Supprime la config ET force la purge immediate des donnees (sans quoi
 * Drupal se contente de marquer le champ "supprime", la table restant en
 * base jusqu'a la prochaine purge cron/drush) : le champ ne doit plus rien
 * laisser derriere lui.
 *
 * Idempotent : ne fait rien si le champ est deja supprime.
 */
function drivematic_configurator_update_11007(): string {
  $field_storage = FieldStorageConfig::loadByName('user', 'field_discount_rate');
  if (!$field_storage) {
    return 'Champ "field_discount_rate" deja supprime : mise a jour ignoree.';
  }

  $field_storage->delete();

  \Drupal::moduleHandler()->loadInclude('field', 'inc', 'field.purge');
  field_purge_batch(1000);

  return 'Champ "field_discount_rate" supprime (config + donnees purgees) sur l\'entite "user".';
}

/**
 * Installe le champ `equipment_type` sur l'entite `quote_equipment_line`.
 *
 * Cle machine du type d'equipement catalogue (`retrovision_ext`/
 * `retrovision_int`/`telecommande_vor`/`pedalier`, memes valeurs que
 * EquipmentPrice::type_equipement) : necessaire pour rattacher une ligne a
 * l'une des 4 remises partenaire par equipement (PartnerDiscountResolver).
 * `label` (chaine traduite) ne suffisait pas a cet usage, pas une cle stable.
 *
 * Les lignes deja persistees avant ce champ restent vides a l'issue de cette
 * seule mise a jour — voir cependant `drivematic_configurator_update_11009()`,
 * qui les retro-complete a partir de leur `label` (mapping fiable, ADR-043
 * addendum : contrairement a un prix, un libelle d'equipement est une valeur
 * fixe parmi 4, sans ambiguite possible).
 *
 * Idempotent : `installFieldStorageDefinition()` ne fait rien si le champ
 * existe deja.
 */
function drivematic_configurator_update_11008(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();

  if ($update_manager->getFieldStorageDefinition('equipment_type', 'quote_equipment_line')) {
    return 'Champ "equipment_type" deja installe sur "quote_equipment_line" : mise a jour ignoree.';
  }

  $storage_definition = BaseFieldDefinition::create('string')
    ->setLabel(new TranslatableMarkup('Type équipement catalogue'))
    ->setSetting('max_length', 32)
    ->setName('equipment_type')
    ->setTargetEntityTypeId('quote_equipment_line');

  $update_manager->installFieldStorageDefinition('equipment_type', 'quote_equipment_line', 'drivematic_configurator', $storage_definition);

  return 'Champ "equipment_type" installe sur l\'entite "quote_equipment_line".';
}

/**
 * Retro-complete `equipment_type` sur les lignes anterieures a ce champ.
 *
 * Necessaire pour la refonte de QuoteDiscountForm (ADR-043 addendum) : le
 * formulaire regroupe desormais la remise Drive Matic par TYPE d'equipement
 * (4 lignes fixes) plutot que par ligne/configuration — une ligne dont
 * `equipment_type` reste vide devient invisible/inaccessible depuis ce
 * nouveau formulaire, alors qu'elle reste bien reelle sur le devis.
 *
 * Deduit le type depuis `label` (chaine figee parmi 4 valeurs connues,
 * memes libelles que QuoteCalculator::EQUIPMENT_CATALOG_TYPES) : fiable, a
 * la difference d'un prix qui aurait pu changer depuis.
 *
 * Idempotent : ignore toute ligne dont `equipment_type` est deja renseigne.
 */
function drivematic_configurator_update_11009(): string {
  $label_to_type = [
    'Télécommande VOR' => 'telecommande_vor',
    'Rétrovision extérieure' => 'retrovision_ext',
    'Rétrovision intérieure' => 'retrovision_int',
    'Double pédalier auto-école' => 'pedalier',
  ];

  $line_storage = \Drupal::entityTypeManager()->getStorage('quote_equipment_line');
  $ids = $line_storage->getQuery()->accessCheck(FALSE)->execute();

  $updated = 0;
  /** @var \Drupal\drivematic_configurator\Entity\QuoteEquipmentLine $line */
  foreach ($line_storage->loadMultiple($ids) as $line) {
    if (!empty($line->get('equipment_type')->value)) {
      continue;
    }

    $type = $label_to_type[$line->get('label')->value] ?? NULL;
    if ($type === NULL) {
      continue;
    }

    $line->set('equipment_type', $type)->save();
    $updated++;
  }

  return $updated
    ? sprintf('%d ligne(s) retro-completee(s) avec leur equipment_type.', $updated)
    : 'Aucune ligne a completer : mise a jour ignoree (deja a jour ou base vide).';
}

/**
 * Fige `dm_discount_rate` sur les lignes jamais reellement modifiees.
 *
 * Avant ADR-043, `dm_discount_rate` avait une valeur par defaut de 0 (au
 * lieu d'un snapshot du taux partenaire) : toute ligne de devis creee avant
 * cette refonte porte donc un 0 explicite en base, indiscernable d'un 0
 * volontairement enregistre — et qui masque a tort la remise partenaire
 * dans la section « Remises par équipement ».
 *
 * Distingue les deux cas via `quote_discount_change` (ADR-040) : une ligne
 * qui y figure a ete reellement modifiee au moins une fois par un
 * administrateur — sa valeur actuelle est une decision explicite, jamais
 * touchee ici, quelle qu'elle soit (y compris 0). Une ligne absente de cet
 * historique n'a jamais ete touchee : son taux est ecrase par le snapshot
 * du compte partenaire A CET INSTANT (0.0 si absent) — jamais laisse a
 * NULL, pour qu'aucune resolution live ne s'y applique plus jamais ensuite
 * (ADR-043 addendum 2 : un devis fige ses taux a la creation, point final).
 *
 * Portee volontairement limitee aux devis encore au statut
 * Quote::STATUS_A_COMMANDER : au-dela (Commandé/Archivé), le prix doit
 * rester fige (meme principe que le gel pose par QuoteMarkOrderedForm).
 *
 * Recalcule aussi les totaux geles du devis (Quote::total_*) pour chaque
 * devis dont au moins une ligne a change, avec la meme formule que
 * QuoteDiscountForm::recalculateTotals(). Ne regenere pas le PDF deja
 * existant (limite acceptee, symetrique a celle du reste du module : seul
 * un enregistrement explicite de remise le regenere).
 *
 * Idempotent : une ligne deja au bon taux, ou deja presente dans
 * l'historique, n'est jamais retouchee.
 */
function drivematic_configurator_update_11010(): string {
  $quote_storage = \Drupal::entityTypeManager()->getStorage('quote');
  $configuration_storage = \Drupal::entityTypeManager()->getStorage('quote_configuration');
  $line_storage = \Drupal::entityTypeManager()->getStorage('quote_equipment_line');
  $change_storage = \Drupal::entityTypeManager()->getStorage('quote_discount_change');
  $resolver = \Drupal::service('drivematic_configurator.partner_discount_resolver');

  $touched_line_ids = [];
  $change_ids = $change_storage->getQuery()->accessCheck(FALSE)->execute();
  foreach ($change_storage->loadMultiple($change_ids) as $change) {
    $touched_line_ids[(int) $change->get('line_id')->target_id] = TRUE;
  }

  $quote_ids = $quote_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('status', Quote::STATUS_A_COMMANDER)
    ->execute();

  $frozen_lines = 0;
  $updated_quotes = 0;

  /** @var \Drupal\drivematic_configurator\Entity\Quote $quote */
  foreach ($quote_storage->loadMultiple($quote_ids) as $quote) {
    $configuration_ids = $configuration_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('quote_id', $quote->id())
      ->execute();
    if (!$configuration_ids) {
      continue;
    }

    $line_ids = $line_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('configuration_id', $configuration_ids, 'IN')
      ->condition('unavailable', FALSE)
      ->execute();
    if (!$line_ids) {
      continue;
    }

    $account = $quote->getOwner();
    $quote_changed = FALSE;

    /** @var \Drupal\drivematic_configurator\Entity\QuoteEquipmentLine $line */
    foreach ($line_storage->loadMultiple($line_ids) as $line) {
      if (isset($touched_line_ids[(int) $line->id()])) {
        continue;
      }

      $rate = round($resolver->resolve($account, $line->get('equipment_type')->value) ?? 0.0, 2);
      $current = $line->get('dm_discount_rate')->value;
      if ($current !== NULL && round((float) $current, 2) === $rate) {
        continue;
      }

      $line->set('dm_discount_rate', $rate)->save();
      $frozen_lines++;
      $quote_changed = TRUE;
    }

    if (!$quote_changed) {
      continue;
    }

    $total_ht = 0.0;
    $total_discounted_ht = 0.0;
    foreach ($line_storage->loadMultiple($line_ids) as $line) {
      $total_ht += (float) $line->get('ht')->value;
      $total_discounted_ht += $line->getEffectiveDiscountedHt() ?? 0.0;
    }
    $vat = $total_discounted_ht * 0.20;

    $quote->set('total_ht', $total_ht);
    $quote->set('total_discount', $total_ht - $total_discounted_ht);
    $quote->set('total_discounted_ht', $total_discounted_ht);
    $quote->set('total_vat', $vat);
    $quote->set('total_ttc', $total_discounted_ht + $vat);
    $quote->save();
    $updated_quotes++;
  }

  return $frozen_lines
    ? sprintf('%d ligne(s) figee(s) sur %d devis "à commander" ; totaux recalcules.', $frozen_lines, $updated_quotes)
    : 'Aucune ligne a figer : mise a jour ignoree.';
}
