<?php

/**
 * @file
 * Espace partenaire DRIVE-MATIC.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\user\UserInterface;

/**
 * Implements hook_form_FORM_ID_alter() for user_form.
 *
 * `/user/{user}/edit` (formulaire core `user_form`, classe `ProfileForm`) est
 * accessible par defaut a tout utilisateur authentifie pour SON PROPRE
 * compte, independamment des permissions de role — c'est aussi la page sur
 * laquelle atterrit un partenaire en cliquant le lien de definition de mot
 * de passe de l'e-mail d'activation (meme route, jeton `pass-reset-token` en
 * plus). Les 11 champs profil partenaire sont exposes sur l'affichage de
 * formulaire par defaut pour que l'admin puisse les remplir a la
 * creation/edition d'un compte partenaire (`/admin/people/*`) — mais ce meme
 * affichage par defaut est aussi celui de ce formulaire d'auto-edition. Sans
 * ce filtre, un partenaire pourrait donc contourner le caractere
 * lecture-seule impose par `PersonalInformationForm` (e-mail + bloc « Votre
 * entreprise ») simplement en visitant directement `/user/{uid}/edit`.
 *
 * Pour la meme raison, `user_picture`/`language`/`timezone` (hors perimetre
 * de `PersonalInformationForm`, sans utilite pour un partenaire) sont
 * retires, l'e-mail est passe en lecture seule (coherent avec
 * `PersonalInformationForm`), et la redirection post-sauvegarde pointe vers
 * « Mes informations personnelles » plutot que la page de compte par
 * defaut.
 *
 * Tout cela reste visible/editable/inchange quand un compte avec la
 * permission `administer users` (seul `administrator`, bypass `is_admin`,
 * aujourd'hui) edite le compte de quelqu'un d'autre — ce cas ajoute en plus
 * un recapitulatif en lecture seule des adresses de livraison du partenaire
 * (_drivematic_partner_add_delivery_addresses_summary()) et l'historique des
 * changements de remise (_drivematic_partner_add_discount_history_summary(),
 * ADR-044) : consolidations demandees cote back-office.
 */
function drivematic_partner_form_user_form_alter(array &$form, FormStateInterface $form_state): void {
  $account = $form_state->getFormObject()->getEntity();
  $editing_own_account = (int) $account->id() === (int) \Drupal::currentUser()->id();
  $is_admin = \Drupal::currentUser()->hasPermission('administer users');

  if (!$editing_own_account && $is_admin) {
    _drivematic_partner_add_delivery_addresses_summary($form, $account);
    _drivematic_partner_add_discount_history_summary($form, $account);
  }

  if (!$editing_own_account || $is_admin) {
    return;
  }

  foreach (_drivematic_partner_profile_field_names() as $field_name) {
    unset($form[$field_name]);
  }
  unset($form['user_picture'], $form['language'], $form['timezone']);

  $form['account']['mail']['#attributes']['readonly'] = 'readonly';

  // Le bouton de soumission porte son propre `#submit` (['::submitForm',
  // '::save'], pose par EntityForm::actions()) : il prime sur $form['#submit']
  // pour l'element declencheur, qui reste donc sans effet ici — l'ajout doit
  // se faire directement sur le bouton.
  $form['actions']['submit']['#submit'][] = '_drivematic_partner_user_form_redirect';
}

/**
 * Redirige vers « Mes informations personnelles » apres sauvegarde.
 *
 * Callback #submit ajoutee APRES celles de `ProfileForm::save()` : elle
 * s'execute a la suite et remplace donc la redirection par defaut du cœur
 * (page de compte), sans la dupliquer.
 */
function _drivematic_partner_user_form_redirect(array &$form, FormStateInterface $form_state): void {
  $form_state->setRedirect('drivematic_partner.personal_information');
}

/**
 * Ajoute un recapitulatif en lecture seule des adresses de livraison.
 *
 * Consolide sur `/user/{uid}/edit` une information sinon consultable
 * uniquement depuis l'espace partenaire lui-meme (entite `delivery_address`,
 * module drivematic_configurator, ecran `/configurer/livraison`) : sans
 * cela, un admin doit se connecter a la place du partenaire pour voir ses
 * adresses. Lecture seule (aucun lien modifier/supprimer) : la gestion
 * reste du ressort exclusif du partenaire, depuis son propre espace.
 *
 * `DeliveryAddressAccessControlHandler` ouvre deja l'operation 'view' a tout
 * compte `administer users` — pas de verification d'acces supplementaire
 * requise ici, cet appel n'etant execute que dans ce meme contexte (voir
 * drivematic_partner_form_user_form_alter()).
 */
function _drivematic_partner_add_delivery_addresses_summary(array &$form, UserInterface $account): void {
  $addresses = \Drupal::entityTypeManager()
    ->getStorage('delivery_address')
    ->loadByProperties(['uid' => $account->id()]);

  $items = [];
  foreach ($addresses as $address) {
    $complement = $address->get('complement')->value;
    $summary = sprintf(
      '%s, %s%s, %s %s',
      $address->get('raison_sociale')->value,
      $address->get('adresse')->value,
      $complement ? ', ' . $complement : '',
      $address->get('code_postal')->value,
      $address->get('ville')->value,
    );
    if ($address->get('is_default')->value) {
      $summary .= ' — ' . t('adresse par défaut');
    }
    $items[] = $summary;
  }

  $form['delivery_addresses'] = [
    '#type' => 'details',
    '#title' => t('Adresses de livraison'),
    '#open' => TRUE,
    '#weight' => 5,
    'list' => [
      '#theme' => 'item_list',
      '#items' => $items,
      '#empty' => t('Aucune adresse de livraison enregistrée.'),
    ],
  ];
}

/**
 * Ajoute un historique en lecture seule des changements de remise.
 *
 * Consolide sur `/user/{uid}/edit` chaque changement reel de l'un des 4
 * champs `field_discount_<type>` (ADR-043), quel que soit le canal qui l'a
 * ecrit (ce formulaire, `drush`, script) — voir
 * `drivematic_configurator_user_update()` (module drivematic_configurator,
 * qui possede deja la logique metier des remises) pour la detection et
 * l'ecriture de l'historique.
 *
 * But (ADR-044) : permettre a Drive Matic de verifier QUAND un taux a
 * reellement change, pour justifier un devis fige avant ce changement
 * (ADR-043 addendum 2 : un devis ne suit plus jamais le compte partenaire
 * apres sa creation).
 *
 * Meme garde d'acces que `_drivematic_partner_add_delivery_addresses_summary()`
 * (voir drivematic_partner_form_user_form_alter()) : jamais visible en
 * auto-edition, cette information restant une donnee commerciale interne.
 */
function _drivematic_partner_add_discount_history_summary(array &$form, UserInterface $account): void {
  $storage = \Drupal::entityTypeManager()->getStorage('partner_discount_change');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('partner_id', $account->id())
    ->sort('created', 'ASC')
    ->execute();

  $rows = [];
  /** @var \Drupal\drivematic_configurator\Entity\PartnerDiscountChange $change */
  foreach ($storage->loadMultiple($ids) as $change) {
    $author = $change->get('uid')->entity;
    $rows[] = [
      \Drupal::service('date.formatter')->format((int) $change->get('created')->value, 'short'),
      _drivematic_partner_discount_equipment_label((string) $change->get('equipment_type')->value),
      _drivematic_partner_format_discount_rate($change->get('old_rate')->value) . ' → ' . _drivematic_partner_format_discount_rate($change->get('new_rate')->value),
      $author ? $author->getDisplayName() : t('Compte supprimé'),
    ];
  }

  $form['discount_history'] = [
    '#type' => 'details',
    '#title' => t('Historique des remises'),
    '#open' => TRUE,
    '#weight' => 6,
    'table' => [
      '#type' => 'table',
      '#header' => [t('Date'), t('Équipement'), t('Modification'), t('Modifié par')],
      '#rows' => $rows,
      '#empty' => t('Aucune modification enregistrée.'),
    ],
  ];
}

/**
 * Libellé d'un type d'équipement catalogue (jamais un `t()` sur variable).
 *
 * Mêmes clés que PartnerDiscountResolver/QuoteDiscountForm (ADR-028 :
 * mapping dupliqué faute de source canonique unique dans le projet).
 */
function _drivematic_partner_discount_equipment_label(string $type): TranslatableMarkup {
  return match ($type) {
    'retrovision_ext' => t('Rétrovision extérieure'),
    'retrovision_int' => t('Rétrovision intérieure'),
    'telecommande_vor' => t('Télécommande VOR'),
    'pedalier' => t('Double pédalier auto-école'),
    default => t('Équipement inconnu'),
  };
}

/**
 * Formate un taux de remise (%), ou « — (vide) » si absent.
 *
 * Ne jamais confondre l'absence de remise négociée (NULL) avec une remise
 * explicite de 0% (ADR-044).
 */
function _drivematic_partner_format_discount_rate(mixed $rate): string {
  if ($rate === NULL || $rate === '') {
    return (string) t('— (vide)');
  }
  return number_format((float) $rate, 2, ',', ' ') . ' %';
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 *
 * `/user/login` (formulaire core `UserLoginForm`) redirige par defaut vers
 * la page de compte (`entity.user.canonical`, `/user/{uid}`) — sans interet
 * pour un partenaire, dont la page d'atterrissage naturelle est « Mes
 * informations personnelles » (meme raisonnement que la redirection posee
 * sur `user_form`, `_drivematic_partner_user_form_redirect()`).
 *
 * Scope au role `partenaire` : cette page exige `_role: partenaire`
 * (drivematic_partner.routing.yml) — rediriger un compte qui ne l'a pas
 * (un admin sans ce role) y renverrait un acces refuse.
 *
 * Pas de `#submit` sur le bouton comme pour `user_form` : `user_login_form`
 * est un `FormBase` simple, pas un `EntityForm` — son bouton ne porte pas de
 * `#submit` propre qui primerait sur `$form['#submit']`.
 *
 * Un `destination` explicite (ex. redirection depuis une page protegee)
 * continue de l'emporter : `RedirectResponseSubscriber` l'applique
 * apres coup, quel que soit ce que ce callback definit ici.
 */
function drivematic_partner_form_user_login_form_alter(array &$form, FormStateInterface $form_state): void {
  $form['#submit'][] = '_drivematic_partner_user_login_redirect';
}

/**
 * Redirige un partenaire vers « Mes informations personnelles ».
 *
 * Callback #submit ajoutee APRES celle de `UserLoginForm::submitForm()`, qui
 * a deja appele `user_login_finalize()` a ce stade : `\Drupal::currentUser()`
 * reflete donc deja le compte fraichement authentifie.
 */
function _drivematic_partner_user_login_redirect(array &$form, FormStateInterface $form_state): void {
  if (\Drupal::currentUser()->hasRole('partenaire')) {
    $form_state->setRedirect('drivematic_partner.personal_information');
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_logout_confirm.
 *
 * `/user/logout/confirm` (formulaire core `UserLogoutConfirm`, atterrissage
 * du lien « Me déconnecter » du dropdown « Espace partenaire ») n'affiche par
 * defaut aucun texte visible : le bloc titre de page est masque sur cette
 * route (meme comportement que /user/login et /user/password, la condition
 * de visibilite `entity_bundle:node` du bloc ne pouvant pas s'evaluer hors
 * contexte de node), et la route n'a pas de `_title` statique en repli — la
 * question du core (`getQuestion()`, deja portee par `$form['#title']` a ce
 * stade, apres `ConfirmFormBase::buildForm()`) ne s'affiche donc nulle part,
 * ni dans l'onglet du navigateur ni dans la page. On la rend visible en
 * texte, sans dupliquer la chaine traduite.
 */
function drivematic_partner_form_user_logout_confirm_alter(array &$form, FormStateInterface $form_state): void {
  $form['question'] = [
    '#type' => 'html_tag',
    '#tag' => 'p',
    '#value' => $form['#title'],
    '#weight' => -10,
  ];
}

/**
 * Noms des 15 champs du profil partenaire portes par l'entite User.
 *
 * Les 4 remises par equipement (field_discount_retrovision_ext/
 * retrovision_int/telecommande_vor/pedalier, ADR-043) ne sont ni affichees
 * ni modifiables par le partenaire nulle part, contrairement aux 11 autres
 * (visibles en lecture seule sur PersonalInformationForm pour le bloc
 * entreprise) : ce sont des donnees commerciales internes, jamais exposees
 * en front. Les masquer ici sur `/user/{uid}/edit` suffit puisqu'elles
 * n'apparaissent par ailleurs sur aucun formulaire consultable par le
 * partenaire.
 *
 * @return string[]
 *   Les noms machine des champs.
 */
function _drivematic_partner_profile_field_names(): array {
  return [
    'field_civility',
    'field_first_name',
    'field_last_name',
    'field_job_title',
    'field_phone',
    'field_siret',
    'field_company_name',
    'field_company_address',
    'field_address_complement',
    'field_postal_code',
    'field_city',
    'field_discount_retrovision_ext',
    'field_discount_retrovision_int',
    'field_discount_telecommande_vor',
    'field_discount_pedalier',
  ];
}
