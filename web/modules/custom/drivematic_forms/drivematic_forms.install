<?php

/**
 * @file
 * Fonctions de mise a jour du module DRIVE-MATIC Formulaires.
 */

declare(strict_types=1);

use Drupal\Core\Field\Entity\BaseFieldOverride;
use Drupal\field\Entity\FieldConfig;
use Drupal\node\Entity\Node;

/**
 * Mutualise le bundle "Devenir partenaire" en "Page :: Formulaire simple".
 *
 * Le nom technique d'un type de contenu ne peut pas etre renomme : on cree
 * donc le bundle `simple_form` (config deja importee dans config/sync), on y
 * bascule le node "Devenir partenaire" existant (les champs `body`,
 * `field_webform` et `field_meta_tags` restent sur le meme storage partage,
 * aucune perte de donnees), on cree le node "Demande de création de compte"
 * sur ce meme bundle avec le webform `partner` en attendant la creation de
 * son propre webform (cf. tache), puis on supprime le bundle `partner`
 * devenu vide.
 *
 * Idempotent : si le bundle `partner` n'existe plus, la mise a jour a deja
 * ete appliquee et ne fait rien.
 */
function drivematic_forms_update_11001(): string {
  $node_type_storage = \Drupal::entityTypeManager()->getStorage('node_type');
  $partner_type = $node_type_storage->load('partner');

  if (!$partner_type) {
    return 'Bundle "partner" deja absent : mise a jour ignoree (deja appliquee).';
  }

  $node_storage = \Drupal::entityTypeManager()->getStorage('node');

  // 1. Bascule des nodes existants vers le nouveau bundle.
  $partner_nodes = $node_storage->loadByProperties(['type' => 'partner']);
  foreach ($partner_nodes as $node) {
    $node->set('type', 'simple_form');
    $node->save();
  }

  // 2. Creation du node "Demande de création de compte".
  $request_node = Node::create([
    'type' => 'simple_form',
    'langcode' => 'fr',
    'uid' => 0,
    'status' => 1,
    'title' => 'Demande de création de compte',
    'field_webform' => ['target_id' => 'partner'],
  ]);
  $request_node->save();

  // 3. Suppression du bundle "partner" : dependants d'abord, bundle en dernier.
  \Drupal::configFactory()
    ->getEditable('simple_sitemap.bundle_settings.default.node.partner')
    ->delete();

  \Drupal::entityTypeManager()->getStorage('pathauto_pattern')
    ->load('node_partner')?->delete();

  \Drupal::entityTypeManager()->getStorage('metatag_defaults')
    ->load('node__partner')?->delete();

  \Drupal::entityTypeManager()->getStorage('entity_view_display')
    ->load('node.partner.default')?->delete();

  \Drupal::entityTypeManager()->getStorage('entity_form_display')
    ->load('node.partner.default')?->delete();

  foreach (['body', 'field_webform', 'field_meta_tags'] as $field_name) {
    FieldConfig::loadByName('node', 'partner', $field_name)?->delete();
  }

  BaseFieldOverride::loadByName('node', 'partner', 'title')?->delete();

  $partner_type->delete();

  return sprintf(
    'Bundle "partner" mutualise en "simple_form" : %d node(s) bascule(s), node "Demande de création de compte" (nid %d) cree, bundle "partner" supprime.',
    count($partner_nodes),
    (int) $request_node->id()
  );
}

/**
 * Rattache son propre webform au node "Demande de création de compte".
 *
 * Le node cree par drivematic_forms_update_11001() pointait provisoirement
 * vers le webform `partner` (cf. note de l'ADR-024, levee par cette mise a
 * jour). Le webform `account_request` doit deja avoir ete importe via
 * `drush cim` avant de lancer cette mise a jour.
 *
 * Idempotent : ne fait rien si le node est deja rattache a `account_request`
 * ou si le webform `account_request` n'est pas encore importe.
 */
function drivematic_forms_update_11002(): string {
  $webform_storage = \Drupal::entityTypeManager()->getStorage('webform');
  if (!$webform_storage->load('account_request')) {
    return 'Webform "account_request" absent (config non importee) : mise a jour ignoree.';
  }

  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $nodes = $node_storage->loadByProperties([
    'type' => 'simple_form',
    'title' => 'Demande de création de compte',
  ]);
  $request_node = reset($nodes);

  if (!$request_node) {
    return 'Node "Demande de création de compte" introuvable : mise a jour ignoree.';
  }

  if ($request_node->get('field_webform')->target_id === 'account_request') {
    return 'Node "Demande de création de compte" deja rattache a "account_request" : mise a jour ignoree (deja appliquee).';
  }

  $request_node->set('field_webform', ['target_id' => 'account_request']);
  $request_node->save();

  return sprintf(
    'Node "Demande de création de compte" (nid %d) rattache au webform "account_request".',
    (int) $request_node->id()
  );
}
