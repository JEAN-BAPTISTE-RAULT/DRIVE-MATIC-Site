<?php

/**
 * @file
 * Comportements custom des formulaires DRIVE-MATIC.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_alter().
 *
 * Attache la cascade marque -> modele -> motorisation sur le webform contact.
 */
function drivematic_forms_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (!str_starts_with($form_id, 'webform_submission_contact')) {
    return;
  }
  $form['#attached']['library'][] = 'drivematic_forms/vehicle_select';
  $form['#attached']['drupalSettings']['drivematicForms'] = _drivematic_forms_vehicle_map();
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 *
 * Convention de formulaire BO : les blocs techniques ne sont pas proposes a la
 * saisie. `uid` et `created` sortent par le form display, mais `simple_sitemap`
 * et `url_redirects` sont ajoutes par leurs modules dans le groupe « advanced »
 * **sans consulter le form display** : les desactiver en configuration ne
 * suffit pas, il faut les retirer ici.
 *
 * Aucune donnee n'est perdue : le reglage sitemap reste porte par le type de
 * contenu, et les redirections restent gerables depuis leur page dediee.
 */
function drivematic_forms_form_node_form_alter(array &$form, FormStateInterface $form_state): void {
  $form['#after_build'][] = '_drivematic_forms_strip_technical_blocks';
}

/**
 * Retire les blocs techniques du formulaire de node (callback #after_build).
 *
 * Le retrait se fait en `#after_build` et non dans l'alter : `redirect` et
 * `simple_sitemap` ajoutent leurs elements **apres** notre implementation, y
 * compris avec un poids de module superieur (teste, puis remis a 0 : inutile).
 * `#after_build` est le dernier point de passage, donc le seul fiable ici.
 */
function _drivematic_forms_strip_technical_blocks(array $form, FormStateInterface $form_state): array {
  unset($form['simple_sitemap'], $form['url_redirects']);

  return $form;
}

/**
 * Implements hook_field_widget_single_element_WIDGET_TYPE_form_alter().
 *
 * La description d'un fichier sert de libelle a son bouton de telechargement
 * (ADR-009) : un document sans description donnerait un bouton sans nom. On la
 * rend donc obligatoire, et on la nomme pour ce qu'elle est.
 *
 * Le cœur ne propose pas ce reglage : `description_field` n'a pas de pendant
 * « obligatoire ». La description est construite par un `#process` de
 * FileWidget, et seulement si un fichier est deja joint : on ajoute donc notre
 * callback APRES le sien. Consequence utile — un champ fichier laisse vide
 * reste facultatif, seul un document effectivement deverse exige un libelle.
 */
function drivematic_forms_field_widget_single_element_file_generic_form_alter(array &$element, FormStateInterface $form_state, array $context): void {
  $element['#process'][] = '_drivematic_forms_require_file_description';
}

/**
 * Rend obligatoire la description d'un fichier deverse (callback #process).
 *
 * @param array $element
 *   L'element `managed_file` en cours de construction.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   Etat du formulaire.
 * @param array $form
 *   Le formulaire complet.
 *
 * @return array
 *   L'element, description marquee obligatoire si elle existe.
 */
function _drivematic_forms_require_file_description(array $element, FormStateInterface $form_state, array $form): array {
  if (!isset($element['description'])) {
    return $element;
  }

  $element['description']['#required'] = TRUE;
  $element['description']['#title'] = t('Libellé du bouton de téléchargement');
  $element['description']['#description'] = t('Exemple : « Notice technique ». Le format et le poids du fichier sont ajoutés automatiquement.');

  return $element;
}

/**
 * Construit les correspondances vehicule pour la cascade front.
 *
 * @return array
 *   Deux maps indexees par identifiant de terme : 'modelsByBrand' (marque =>
 *   liste de modeles) et 'motosByModel' (modele => liste de motorisations).
 */
function _drivematic_forms_vehicle_map(): array {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $models = $storage->loadByProperties(['vid' => 'vehicle_model']);
  $models_by_brand = [];
  $motos_by_model = [];
  foreach ($models as $model) {
    $brand = $model->get('field_brand')->target_id;
    if ($brand) {
      $models_by_brand[$brand][] = (int) $model->id();
    }
    $motos_by_model[(int) $model->id()] = array_map(
      static fn(array $item): int => (int) $item['target_id'],
      $model->get('field_motorisations')->getValue()
    );
  }
  return [
    'modelsByBrand' => $models_by_brand,
    'motosByModel' => $motos_by_model,
  ];
}
