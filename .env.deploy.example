# Copier ce fichier vers .env.deploy (gitignore, jamais committe) et
# renseigner les vraies valeurs. Voir scripts/deploy-preprod.sh et
# .claude/decisions/039-deploiement-preprod-rsync.md

PREPROD_HOST=
PREPROD_USER=
PREPROD_PORT=
PREPROD_PATH=

# Necessaires uniquement pour le backup (pas requis avec --no-backup).
# PREPROD_BACKUP_PATH doit deja contenir un fichier .my.cnf (credentials
# mysqldump), pose par le sysadmin hors de ce depot.
PREPROD_BACKUP_PATH=
PREPROD_DB_NAME=
